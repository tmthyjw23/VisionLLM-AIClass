# Copy this file to .env and fill with your own credentials
# NEVER commit .env to git - only .env.example is tracked

# === Vision LLM Provider (9router proxy or direct Gemini API) ===
# Option A: 9router local proxy (default for class demo)
VISION_PROVIDER=9router
VISION_BASE_URL=http://localhost:20128/v1
VISION_MODEL=ag/gemini-3.8-flash-high
VISION_API_KEY=sk-REPLACE_WITH_YOUR_KEY

# Option B: Direct Google Gemini API (for serverless/Vercel)
# Get key at https://aistudio.google.com/app/apikey
# VISION_BASE_URL=https://generativelanguage.googleapis.com/v1
# VISION_MODEL=gemini-1.5-flash
# VISION_API_KEY=AIzaSy-REPLACE_WITH_YOUR_GEMINI_KEY

# === Ollama (optional, for local LLM fallback) ===
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=gemma3:4b
# OLLAMA_API_KEY=dummy_key_untuk_lokal

# === Camera ===
VISION_CAMERA_INDEX=0
VISION_FPS=5
